{
  "version": 1,
  "sdk_version": "3.0.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xkhleosrspxxdhtgwaqg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "traders-world",
      "version": "0.1.0",
      "title": "Traders World"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in trader's TradersWorld profile.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_journal_entries",
        "title": "List journal entries",
        "description": "List the signed-in trader's most recent trading log entries.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max entries to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_journal_entry",
        "title": "Add journal entry",
        "description": "Log a new trade in the signed-in trader's trading log.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "market_pair": {
              "type": "string",
              "minLength": 1,
              "description": "Instrument, e.g. EURUSD or ES."
            },
            "result": {
              "type": "string",
              "enum": [
                "win",
                "loss",
                "breakeven"
              ],
              "description": "Trade outcome."
            },
            "pnl_pips": {
              "type": "number",
              "description": "Profit/loss amount."
            },
            "notes": {
              "type": "string",
              "maxLength": 5000,
              "description": "Trade notes."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Performance tags."
            }
          },
          "required": [
            "market_pair"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
